{"report_id":"wh63q","is_trip_report":true,"reason":"First-person account of a specific DMT experience with vibrating room, space flight, a yellow sphere and voices.","scenes":[{"place":"my bathroom, only bathroom light on","order":1,"light":["only my bathroom light is on"],"colour":[],"motion":["everything vibrating","every line shaking"],"geometry":["lines"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["walked out, turned off light, lay down"],"affect":["panic","surprise"],"quotes":[{"text":"everything started vibrating","start":997,"end":1025,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"very single line in my bathroom was shaking","start":1074,"end":1117,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I panic alittle bit and was honestly surprised that it was working","start":1252,"end":1318,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:only my bathroom light is on"],"colour":[],"motion":["other:everything vibrating","other:every line shaking"],"geometry":["lines"],"material":[],"density":[],"scale":[],"affect":["panic","surprise"],"transition_trigger":["other:walked out, turned off light, lay down"],"place":"other:my bathroom, only bathroom light on"}},{"place":"lying on makeshift bed / flying through space","order":2,"light":[],"colour":["shapes of all colors"],"motion":["blasted out of my body","flying","shapes flying past"],"geometry":["geometric shapes"],"material":[],"density":[],"scale":["space"],"beings":[],"transition_trigger":["opened my eyes"],"affect":["too intense","panic"],"quotes":[{"text":"As soon as my head hit the pillow I was gone.","start":1399,"end":1444,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was flying through space with geometric shapes of all colors flying past me","start":1494,"end":1571,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"it was if sound was amplified but muffled at the same time","start":1629,"end":1687,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"At this point I am on a full on panic.","start":1691,"end":1729,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:shapes of all colors"],"motion":["other:blasted out of my body","other:flying","other:shapes flying past"],"geometry":["other:geometric shapes"],"material":[],"density":[],"scale":["other:space"],"affect":["other:too intense","panic"],"transition_trigger":["other:opened my eyes"],"place":"other:lying on makeshift bed / flying through space"}},{"place":"inside a bright yellow sphere","order":3,"light":["bright"],"colour":["bright yellow"],"motion":["I could feel it moving","rippling","free falling"],"geometry":["sphere"],"material":["body felt like water","solid piece of clay"],"density":[],"scale":[],"beings":[{"form":["voices"],"count_text":"the voices","behaviour":["repeating a phrase"],"communication":["\"Do it\"","repeating without pause"],"affect":["demonic, not friendly or inviting"],"normalised":{"form":["other:voices"],"behaviour":["other:repeating a phrase"],"communication":["other:\"Do it\"","other:repeating without pause"],"affect":["other:demonic, not friendly or inviting"]}}],"transition_trigger":["everything began to slow down and the voice stopped"],"affect":["terror","overwhelmed"],"quotes":[{"text":"I was inside a bright yellow sphere and I could feel it moving","start":1899,"end":1961,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"my body felt like water and everytime I touched my chest it rippled","start":2034,"end":2101,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It sounded demonic and it uttered only one phrase, \"Do it\"","start":2233,"end":2291,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"\"DO IT DO IT DO IT DO IT DO IT DO IT\"","start":2383,"end":2420,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"when I looked at my hand it looked like a solid piece of clay the resembled a hand but had no fingers","start":2910,"end":3011,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["bright"],"colour":["other:bright yellow"],"motion":["other:I could feel it moving","other:rippling","other:free falling"],"geometry":["other:sphere"],"material":["other:body felt like water","other:solid piece of clay"],"density":[],"scale":[],"affect":["other:terror","overwhelmed"],"transition_trigger":["other:everything began to slow down and the voice stopped"],"place":"other:inside a bright yellow sphere"}},{"place":"my bedroom reassembling","order":4,"light":[],"colour":["metallic"],"motion":["room coming back together in waves","crawled"],"geometry":[],"material":["metallic clothes"],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["completely overwhelmed","crying","eye opening"],"quotes":[{"text":"Slowly the room started coming back together in waves","start":3014,"end":3067,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"all my clothes were metallic","start":3113,"end":3141,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The trip through every problem in my face at once along with the solution.","start":3315,"end":3389,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was shaking uncontrollably and then I broke down and started balling my eyes out","start":3797,"end":3879,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:metallic"],"motion":["other:room coming back together in waves","other:crawled"],"geometry":[],"material":["other:metallic clothes"],"density":[],"scale":[],"affect":["other:completely overwhelmed","other:crying","other:eye opening"],"transition_trigger":[],"place":"other:my bedroom reassembling"}}],"flags":["unmapped:/scenes/0/light","unmapped:/scenes/0/motion","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/1/colour","unmapped:/scenes/1/motion","unmapped:/scenes/1/geometry","unmapped:/scenes/1/scale","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/2/colour","unmapped:/scenes/2/motion","unmapped:/scenes/2/geometry","unmapped:/scenes/2/material","unmapped:/scenes/2/affect","unmapped:/scenes/2/transition_trigger","unmapped:/scenes/2/place","unmapped:/scenes/2/beings/0/form","unmapped:/scenes/2/beings/0/behaviour","unmapped:/scenes/2/beings/0/communication","unmapped:/scenes/2/beings/0/affect","unmapped:/scenes/3/colour","unmapped:/scenes/3/motion","unmapped:/scenes/3/material","unmapped:/scenes/3/affect","unmapped:/scenes/3/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-8853d340cff144ebb9afcb5a9dc05820","phase":"pilot20","attempt":11}}
{"report_id":"xvm2h","is_trip_report":true,"reason":"First-person account of visuals, sensed beings and shifting perception across a night's experiences.","scenes":[{"place":"bedroom","order":1,"light":[],"colour":["most beautiful, subtle colouring"],"motion":["slowly morphing"],"geometry":["asymmetical pattern of lines and curves","no patterns just perfect version of surroundings"],"material":["slightly transparent hands"],"density":[],"scale":[],"beings":[{"form":["cat"],"count_text":"My cat","behaviour":["jumped up on my bed"],"communication":[],"affect":[],"normalised":{"form":["other:cat"],"behaviour":["other:jumped up on my bed"],"communication":[],"affect":[]}},{"form":["some kind of being, a shaman figure"],"count_text":"one of them","behaviour":["looking after me","putting a blanket on me"],"communication":[],"affect":[],"normalised":{"form":["other:some kind of being, a shaman figure"],"behaviour":["other:looking after me","other:putting a blanket on me"],"communication":[],"affect":[]}}],"transition_trigger":["further [redacted] after ~45 minutes"],"affect":["totally in love","Total bliss","a little scared of breaking through"],"quotes":[{"text":"absolutely beautiful visuals - no patterns or anything, just like I was looking at the perfect version of everything around me.","start":660,"end":787,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"My hands became slightly transparent, and then there was something going on with my thumbs that I couldn't quite work out.","start":789,"end":911,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"a wonderful, slowly morphing, asymetical pattern of lines and curves with the most beautiful, subtle colouring","start":962,"end":1074,"anchor_score":0.990990990990991,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"My cat jumped up on my bed and I was just totally in love with him for a moment. Total bliss.","start":1075,"end":1168,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I had the feeling that there was some kind of being, a shaman figure looking after me.","start":2085,"end":2171,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:most beautiful, subtle colouring"],"motion":["other:slowly morphing"],"geometry":["other:asymmetical pattern of lines and curves","other:no patterns just perfect version of surroundings"],"material":["other:slightly transparent hands"],"density":[],"scale":[],"affect":["other:totally in love","other:Total bliss","other:a little scared of breaking through"],"transition_trigger":["other:further [redacted] after ~45 minutes"],"place":"other:bedroom"}},{"place":"bedroom, lying in bed","order":2,"light":[],"colour":["white sheets looked wrong, like they should have been black"],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[{"form":["shaman figure","couldn't see them"],"count_text":"one of them","behaviour":["putting a blanket on me"],"communication":[],"affect":[],"normalised":{"form":["other:shaman figure","other:couldn't see them"],"behaviour":["other:putting a blanket on me"],"communication":[],"affect":[]}}],"transition_trigger":["came down very quickly"],"affect":["TOO intense","Everything just felt off","laughing at how silly I'd been"],"quotes":[{"text":"This time it was TOO intense.","start":2011,"end":2040,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I couldn't see them, though at one point with my eyes closed I got a quick glimpse of one of them putting a blanket on me.","start":2172,"end":2294,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Even though I have white sheets they just looked totally wrong, like they should have been black or something. Everything just felt off, even though the visuals were pretty much similar.","start":2296,"end":2482,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:white sheets looked wrong, like they should have been black"],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:TOO intense","other:Everything just felt off","other:laughing at how silly I'd been"],"transition_trigger":["other:came down very quickly"],"place":"other:bedroom, lying in bed"}}],"flags":["unmapped:/scenes/0/colour","unmapped:/scenes/0/motion","unmapped:/scenes/0/geometry","unmapped:/scenes/0/material","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/0/beings/0/form","unmapped:/scenes/0/beings/0/behaviour","unmapped:/scenes/0/beings/1/form","unmapped:/scenes/0/beings/1/behaviour","unmapped:/scenes/1/colour","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/1/beings/0/form","unmapped:/scenes/1/beings/0/behaviour","excluded_text_redacted"],"schema_version":"0.4.0","_extraction":{"job":"batch-8853d340cff144ebb9afcb5a9dc05820","phase":"pilot20","attempt":11}}
{"report_id":"urywa","is_trip_report":true,"reason":"The writer recounts personal intense DMT experiences, including a near-breakthrough, alongside a request for advice.","scenes":[{"place":"","order":1,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["got up and walked outside because it was too intense"],"affect":["initially frightened","pure happiness","positive energy","enjoyment","peace"],"quotes":[{"text":"I've still yet to breakthrough but I've had some pretty intense experiences.","start":348,"end":424,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The last time I [redacted], I believe I was close to breaking through but it was too intense so I just had to get up and walk outside.","start":425,"end":554,"anchor_score":1.0,"weak_anchor":false,"redacted":true,"ambiguous_anchor":false},{"text":"the molecule does feel like pure happiness, though strong, i only get positive energy from this substance","start":657,"end":762,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The intense experiences that I've had so far on DMT have initially frightened me, (maybe for about a minute), and after that I find myself really enjoying the substance, liking the visuals, and in a really good place mentally.","start":1096,"end":1322,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:initially frightened","other:pure happiness","other:positive energy","other:enjoyment","other:peace"],"transition_trigger":["other:got up and walked outside because it was too intense"],"place":"other:"}}],"flags":["unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place","redacted:/scenes/0/quotes/1"],"schema_version":"0.4.0","_extraction":{"job":"batch-8853d340cff144ebb9afcb5a9dc05820","phase":"pilot20","attempt":11}}
