{"report_id":"vxswt","is_trip_report":true,"reason":"Writer recounts a personal experience with dancing visuals and body effects.","scenes":[{"place":"outdoors with two companions, looking at the moon","order":1,"light":[],"colour":[],"motion":["dancing visuals","rose slowly"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["very pleasant","controllable","not scary","impressed"],"quotes":[{"text":"Felt different immediately almost like salvia but it was nice and controllable.","start":354,"end":433,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It rose slowly and at its peak I had dancing visuals and a decent body high.","start":434,"end":510,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Felt increased heartrate but not scary by any means.","start":511,"end":563,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Sat back and listened to shpongle, stared at the moon for a bit, kicked it with my two trip companions.","start":564,"end":667,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was impressed overall even though there was no blasting off","start":879,"end":940,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:dancing visuals","other:rose slowly"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:very pleasant","other:controllable","other:not scary","other:impressed"],"transition_trigger":[],"place":"other:outdoors with two companions, looking at the moon"}}],"flags":["unmapped:/scenes/0/motion","unmapped:/scenes/0/affect","unmapped:/scenes/0/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-8853d340cff144ebb9afcb5a9dc05820","phase":"pilot20","attempt":11}}
{"report_id":"yb4yc","is_trip_report":true,"reason":"Writer recounts their own first DMT experience with flash of light, fear, vibrations and euphoria.","scenes":[{"place":"","order":1,"light":["huge white flash of light"],"colour":["white"],"motion":["came over me like a wave","vibrations"],"geometry":[],"material":[],"density":[],"scale":["huge"],"beings":[],"transition_trigger":["negative feelings melted away"],"affect":["anxious","thought I was dying","fear of going crazy","self-reassurance"],"quotes":[{"text":"Immediately I saw a huge white flash of light. I thought I was dying.","start":553,"end":622,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"after the 3rd hit it just came over me live a wave.","start":499,"end":550,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I thought I was going crazy and would never be able to return to my waking life. I kept telling myself \"It's OK\", \"Just relax\".","start":791,"end":918,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:huge white flash of light"],"colour":["white"],"motion":["other:came over me like a wave","other:vibrations"],"geometry":[],"material":[],"density":[],"scale":["other:huge"],"affect":["other:anxious","other:thought I was dying","other:fear of going crazy","other:self-reassurance"],"transition_trigger":["other:negative feelings melted away"],"place":"other:"}},{"place":"","order":2,"light":[],"colour":[],"motion":["vibration changing frequency with humming"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["really happy","euphoric","oneness","disappointment at no visuals"],"quotes":[{"text":"I started to hum along with it and that made me feel really happy.","start":1010,"end":1076,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The sound of the vibrations started to change frequency with my humming and I felt like I was completely one with it.","start":1077,"end":1194,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I didn't get any of the visuals from it","start":1279,"end":1318,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:vibration changing frequency with humming"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:really happy","other:euphoric","other:oneness","other:disappointment at no visuals"],"transition_trigger":[],"place":"other:"}}],"flags":["unmapped:/scenes/0/light","unmapped:/scenes/0/motion","unmapped:/scenes/0/scale","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place","unmapped:/scenes/1/motion","unmapped:/scenes/1/affect","empty_descriptor:/scenes/1/place","unmapped:/scenes/1/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-8853d340cff144ebb9afcb5a9dc05820","phase":"pilot20","attempt":11}}
