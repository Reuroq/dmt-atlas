{"report_id":"qqe9b","is_trip_report":true,"reason":"First-person account of a brief experience with panic, floating sensation and open-eye visuals.","scenes":[{"place":"my room","order":1,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["composing self out of fear"],"affect":["panic","fear","very intense and overwhelmed"],"quotes":[{"text":"i started tripping in seconds. first 10 seconds or so i panicked. it was very intense and overwhelmed me.","start":326,"end":431,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"it started going to the direction toward a bad trip.","start":432,"end":484,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["panic","fear","other:very intense and overwhelmed"],"transition_trigger":["other:composing self out of fear"],"place":"other:my room"}},{"place":"my room","order":2,"light":[],"colour":[],"motion":["rush sensation","dancing","floating"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[{"form":["the two people that i was with"],"count_text":"two people","behaviour":[],"communication":[],"affect":[],"normalised":{"form":["other:the two people that i was with"],"behaviour":[],"communication":[],"affect":[]}}],"transition_trigger":["it all just faded"],"affect":["felt good","dreamy","paradoxical familiarity"],"quotes":[{"text":"from then i felt good and it was almost sort of a rush sensation.","start":605,"end":670,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"at one point, i felt like i was really floating.","start":728,"end":776,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"i got open eye visuals and it was generally very dreamy.","start":778,"end":834,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"i had paradoxical sensation that i'd known the two people that i was with, who i've just met, my entire life.","start":835,"end":944,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"i did not get closed-eye visuals. nor did i feel in a different dimension or space. i was still in my room. and soon it all just faded.","start":981,"end":1116,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:rush sensation","other:dancing","floating"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:felt good","other:dreamy","other:paradoxical familiarity"],"transition_trigger":["other:it all just faded"],"place":"other:my room"}}],"flags":["unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/1/motion","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/1/beings/0/form"],"schema_version":"0.4.0","_extraction":{"job":"batch-59654eaa6311400fa00712ac545b9d80","phase":"pilot20","attempt":10}}
