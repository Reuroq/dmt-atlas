{"report_id":"oau3u","is_trip_report":true,"reason":"Writer recounts a personal breakthrough experience with detailed visions and entities.","scenes":[{"place":"","order":1,"light":[],"colour":[],"motion":["slowed sound"],"geometry":[],"material":["silk curtain eyelids"],"density":[],"scale":[],"beings":[],"transition_trigger":["wall appearing suddenly"],"affect":[],"quotes":[{"text":"I heard: Enjoooooooooooooooooooooyyyy on a very low frequency.","start":160,"end":222,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Every sound around me was muted, and all I heard was this buzz in my ears.","start":223,"end":297,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"my eye lids felt like a silk curtain falling on my eyes","start":320,"end":375,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:slowed sound"],"geometry":[],"material":["other:silk curtain eyelids"],"density":[],"scale":[],"affect":[],"transition_trigger":["other:wall appearing suddenly"],"place":"other:"}},{"place":"vent airway shaped like space","order":2,"light":["super HD sharpness"],"colour":["pink/red metallic","most beautiful colours"],"motion":["soaring"],"geometry":["diamond shaped patterns","vent/airway shape"],"material":["metallic"],"density":[],"scale":["huge wall"],"beings":[{"form":["human like","long face","round shaped, no sharp angles","lines over body going to center of head"],"count_text":"about 2 or 3","behaviour":["surround me","talked","sang","whispered"],"communication":["singing","whispering words never heard before","not understandable"],"affect":[],"normalised":{"form":["other:human like","other:long face","other:round shaped, no sharp angles","other:lines over body going to center of head"],"behaviour":["other:surround me","other:talked","other:sang","other:whispered"],"communication":["other:singing","other:whispering words never heard before","other:not understandable"],"affect":[]}}],"transition_trigger":["opening eyes"],"affect":["freaked me out","bodilessness"],"quotes":[{"text":"Suddenly this huge pink/red metallic coloured wall was in front of me, covered in diamond shaped patterns, I didn't feel my body at all.","start":377,"end":513,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"My soul was soaring through this vent airway shaped like space","start":514,"end":576,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It all was so sharp, so clear..","start":676,"end":707,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was looking things in super HD","start":795,"end":827,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Suddenly these entities surround me, about 2 or 3.","start":829,"end":879,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"They talked to me. They sang to me. They whispered to me, things and words I had never heard of before, I didn't understand what they were saying, but it freaked me out.","start":1104,"end":1273,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:super HD sharpness"],"colour":["other:pink/red metallic","other:most beautiful colours"],"motion":["other:soaring"],"geometry":["other:diamond shaped patterns","other:vent/airway shape"],"material":["metallic"],"density":[],"scale":["other:huge wall"],"affect":["other:freaked me out","other:bodilessness"],"transition_trigger":["other:opening eyes"],"place":"other:vent airway shaped like space"}},{"place":"the room with TV, curtains, sitter friend, cat","order":3,"light":[],"colour":[],"motion":[],"geometry":["pixels","8 / 16 bit"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["closing eyes again"],"affect":["found this funny"],"quotes":[{"text":"I opened my eyes, and I saw everything in 8 / 16 bit. The TV, the curtains, my sitter friend, even the cat. They were all pixels. It was like an oldschool mario game.","start":1274,"end":1440,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I found this funny yet I felt more comfortable in the DMT dimension, so I closed my eyes again.","start":1441,"end":1536,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":["other:pixels","other:8 / 16 bit"],"material":[],"density":[],"scale":[],"affect":["other:found this funny"],"transition_trigger":["other:closing eyes again"],"place":"other:the room with TV, curtains, sitter friend, cat"}},{"place":"vent shaped space","order":4,"light":[],"colour":["colourful"],"motion":["soaring"],"geometry":["vent shape"],"material":[],"density":[],"scale":[],"beings":[{"form":["the entities"],"count_text":"","behaviour":["welcomed me"],"communication":[],"affect":[],"normalised":{"form":["other:the entities"],"behaviour":["other:welcomed me"],"communication":[],"affect":[]}}],"transition_trigger":["suddenly in a cubic room"],"affect":["beautiful"],"quotes":[{"text":"The entities welcomed me, and I was soaring through the vent shaped space, colourful and beautifull.","start":1537,"end":1637,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:colourful"],"motion":["other:soaring"],"geometry":["other:vent shape"],"material":[],"density":[],"scale":[],"affect":["other:beautiful"],"transition_trigger":["other:suddenly in a cubic room"],"place":"other:vent shaped space"}},{"place":"cubic shaped room, green like","order":5,"light":[],"colour":["green"],"motion":[],"geometry":["cubic","diamond shape"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["so weird, 