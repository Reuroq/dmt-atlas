{"report_id":"1yqqy2","is_trip_report":true,"reason":"First-person account of two experiences the same night, with entities, visuals and terror.","scenes":[{"place":"debris in another world","order":1,"light":[],"colour":[],"motion":["being pulled out of debris"],"geometry":[],"material":["debris"],"density":[],"scale":[],"beings":[{"form":["two entities who almost look human"],"count_text":"two","behaviour":["pulling debris off my body","showed me around this world"],"communication":["\"We're so glad you're okay!\"","\"We're so glad you're here!\""],"affect":["lit up with joy"],"normalised":{"form":["other:two entities who almost look human"],"behaviour":["other:pulling debris off my body","other:showed me around this world"],"communication":["other:\"We're so glad you're okay!\"","other:\"We're so glad you're here!\""],"affect":["other:lit up with joy"]}}],"transition_trigger":["opening eyes"],"affect":["true bliss"],"quotes":[{"text":"I 'wake up' to two entities who almost look human pulling debris off my body and then they see my face and they become lit up with joy.","start":861,"end":996,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"they showed me around this world that they lived in","start":1094,"end":1145,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I had a feeling of true bliss.","start":1192,"end":1222,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:being pulled out of debris"],"geometry":[],"material":["other:debris"],"density":[],"scale":[],"affect":["other:true bliss"],"transition_trigger":["other:opening eyes"],"place":"other:debris in another world"}},{"place":"my faintly lit bedroom","order":2,"light":["faintly lit","emitting light"],"colour":[],"motion":["warping and moving","vibrations"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["closing eyes"],"affect":["peaceful"],"quotes":[{"text":"see everything warping and moving and emitting light. My bedroom was not my bedroom anymore.","start":1290,"end":1382,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"all the objects in my bedroom we're almost communicating with these movements and vibrations, it was like a symphony","start":1417,"end":1533,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:faintly lit","other:emitting light"],"colour":[],"motion":["other:warping and moving","other:vibrations"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["calm"],"transition_trigger":["other:closing eyes"],"place":"other:my faintly lit bedroom"}},{"place":"","order":3,"light":[],"colour":["colorful"],"motion":[],"geometry":["fractals","patterns"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["opened eyes, came down"],"affect":[],"quotes":[{"text":"I then closed my eyes and saw the usual crazy colorful fractals and patterns for a good while.","start":1535,"end":1629,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:colorful"],"motion":[],"geometry":["other:fractals","other:patterns"],"material":[],"density":[],"scale":[],"affect":[],"transition_trigger":["other:opened eyes, came down"],"place":"other:"}},{"place":"couch at my house","order":4,"light":[],"colour":["blue and green","turned red and orange","weirdest shades of color I've ever seen"],"motion":["dancing","morphed","clawing","vision vibrating"],"geometry":["fractals","patterns"],"material":[],"density":["sensory overload"],"scale":["felt like an eternity"],"beings":[{"form":["freaky demons"],"count_text":"these demons","behaviour":["clawing and screaming at me"],"communication":["\"YOU ARE NOT WELCOME HERE!!\"","\"LEAVE NOW!!!\""],"affect":[],"normalised":{"form":["other:freaky demons"],"behaviour":["other:clawing and screaming at me"],"communication":["other:\"YOU ARE NOT WELCOME HERE!!\"","other:\"LEAVE NOW!!!\""],"affect":[]}}],"transition_trigger":[],"affect":["terrified","freaked out","thought I was going insane","staring death in the eyes","weak"],"quotes":[{"text":"I saw blue and green fractals and patterns dancing","start":2730,"end":2780,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"the fractals turned red and orange and they almost morphed into these freaky demons that were almost clawing at me","start":2922,"end":3036,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I didn't feel as if they could harm me but I was terrified.","start":3245,"end":3304,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The demons turned into these mind-fucking patterns that were the weirdest shades of color I've ever seen. It was just sensory overload.","start":3305,"end":3440,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was trapped in this, almost 'hell' \nthat felt like an eternity.","start":3539,"end":3604,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"my vision is vibrating like a motherfucker and it almost felt like I was having a seizure","start":3804,"end":3893,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I then came down and 'woke up' with my entire shirt saturated in sweat, all my skin looking pale, and feeling all weak.","start":4442,"end":4561,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:blue and green","other:turned red and orange","other:weirdest shades of color I've ever seen"],"motion":["other:dancing","other:morphed","other:clawing","other:vision vibrating"],"geometry":["other:fractals","other:patterns"],"material":[],"density":["other:sensory overload"],"scale":["other:felt like an eternity"],"affect":["other:terrified","other:freaked out","other:thought I was going insane","other:staring death in the eyes","other:weak"],"transition_trigger":[],"place":"other:couch at my house"}}],"flags":["unmapped:/scenes/0/motion","unmapped:/scenes/0/material","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/0/beings/0/form","unmapped:/scenes/0/beings/0/behaviour","unmapped:/scenes/0/beings/0/communication","unmapped:/scenes/0/beings/0/affect","unmapped:/scenes/1/light","unmapped:/scenes/1/motion","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/2/colour","unmapped:/scenes/2/geometry","unmapped:/scenes/2/transition_trigger","empty_descriptor:/scenes/2/place","unmapped:/scenes/2/place","unmapped:/scenes/3/colour","unmapped:/scenes/3/motion","unmapped:/scenes/3/geometry","unmapped:/scenes/3/density","unmapped:/scenes/3/scale","unmapped:/scenes/3/affect","unmapped:/scenes/3/place","unmapped:/scenes/3/beings/0/form","unmapped:/scenes/3/beings/0/behaviour","unmapped:/scenes/3/beings/0/communication"],"schema_version":"0.4.0","_extraction":{"job":"batch-1157511f04dc43c5990f4df4b96b2476","phase":"pilot200","attempt":18}}
{"report_id":"1y4lh1","is_trip_report":true,"reason":"First-person account of visuals and altered perception during a personal experience.","scenes":[{"place":"dark bedroom, curtains pulled","order":1,"light":["very dark room"],"colour":[],"motion":[],"geometry":[],"material":[],"density":["vapor so thick"],"scale":[],"beings":[],"transition_trigger":["realizing it was way too much"],"affect":["sincere regret","choking discomfort"],"quotes":[{"text":"I had pulled the curtains and it was cloudy out, so the room was very dark.","start":417,"end":492,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"the vapor was so thick that I chocked on it and almost coughed it up several times","start":987,"end":1069,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"practically threw the GVG and lighter away from me in a moment of sincere regret","start":1208,"end":1288,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:very dark room"],"colour":[],"motion":[],"geometry":[],"material":[],"density":["other:vapor so thick"],"scale":[],"affect":["other:sincere regret","other:choking discomfort"],"transition_trigger":["other:realizing it was way too much"],"place":"other:dark bedroom, curtains pulled"}},{"place":"bedroom melting into colour","order":2,"light":[],"colour":["sea of color","vacant color spot","pure black"],"motion":["melting","merging","flowing"],"geometry":["wall","orb surrounding me","tear in spacetime"],"material":["energy"],"density":[],"scale":[],"beings":[],"transition_trigger":["got up and walked to living room"],"affect":["ominous","felt very privileged","illusion insight"],"quotes":[{"text":"The room started to melt into a sea of color.","start":1290,"end":1335,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"the colors merged into an ominous wall of energy that became one flowing orb surrounding me","start":1359,"end":1450,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It looked sort of like a tear in spacetime that showed me nothing but pure black emptiness.","start":1579,"end":1670,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I felt very privileged to be seeing it.","start":1764,"end":1803,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was under the impression that life as we know it is just an illusion","start":1804,"end":1874,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:sea of color","other:vacant color spot","other:pure black"],"motion":["other:melting","other:merging","flowing"],"geometry":["other:wall","other:orb surrounding me","other:tear in spacetime"],"material":["other:energy"],"density":[],"scale":[],"affect":["other:ominous","other:felt very privileged","other:illusion insight"],"transition_trigger":["other:got up and walked to living room"],"place":"other:bedroom melting into colour"}},{"place":"brightly lit living room","order":3,"light":["brightly lit"],"colour":[],"motion":["wobbling","baby steps"],"geometry":["wooden frame and materials"],"material":["wood"],"density":[],"scale":["house absolutely massive","felt like I was in a mansion"],"beings":[],"transition_trigger":[],"affect":["fear of falling","mind blown","at ease","one with the universe"],"quotes":[{"text":"Each baby step was an accomplishment, and I was wobbling all the way while fearing falling down.","start":2024,"end":2120,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"My house was absolutely massive compared to normal.","start":2121,"end":2172,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Everything looked *exactly* the same, but yet somehow completely different.","start":2173,"end":2248,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I remember saying things like \"Everything is going to be okay\"","start":2716,"end":2778,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I felt at ease and totally one with the universe.","start":2820,"end":2869,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:brightly lit"],"colour":[],"motion":["other:wobbling","other:baby steps"],"geometry":["other:wooden frame and materials"],"material":["other:wood"],"density":[],"scale":["other:house absolutely massive","other:felt like I was in a mansion"],"affect":["other:fear of falling","other:mind blown","other:at ease","other:one with the universe"],"transition_trigger":[],"place":"other:brightly lit living room"}}],"flags":["unmapped:/scenes/0/light","unmapped:/scenes/0/density","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/1/colour","unmapped:/scenes/1/motion","unmapped:/scenes/1/geometry","unmapped:/scenes/1/material","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/2/light","unmapped:/scenes/2/motion","unmapped:/scenes/2/geometry","unmapped:/scenes/2/material","unmapped:/scenes/2/scale","unmapped:/scenes/2/affect","unmapped:/scenes/2/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-1157511f04dc43c5990f4df4b96b2476","phase":"pilot200","attempt":18}}
