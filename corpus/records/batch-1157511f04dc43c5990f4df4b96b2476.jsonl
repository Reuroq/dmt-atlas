{"report_id":"1ytqsr","is_trip_report":true,"reason":"Writer recounts a personal experience with closed-eye visuals and near-breakthrough sensations.","scenes":[{"place":"","order":1,"light":[],"colour":[],"motion":["flying through","widening","opening"],"geometry":["vast space opening"],"material":[],"density":[],"scale":["vast"],"beings":[],"transition_trigger":[],"affect":["retained ego","sense of potential"],"quotes":[{"text":"I got really close to breakthrough. I felt less of an acceleration and more of an opening in my mind, as if my peripheral vision was widening.","start":899,"end":1041,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The CEVs were coalescing into these images and sensations of a vast space opening around me that I was flying through, but I contained enough of my ego that I didn't fall into them.","start":1042,"end":1223,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:flying through","other:widening","other:opening"],"geometry":["other:vast space opening"],"material":[],"density":[],"scale":["vast"],"affect":["other:retained ego","other:sense of potential"],"transition_trigger":[],"place":"other:"}}],"flags":["unmapped:/scenes/0/motion","unmapped:/scenes/0/geometry","unmapped:/scenes/0/affect","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-1157511f04dc43c5990f4df4b96b2476","phase":"pilot200","attempt":18}}
