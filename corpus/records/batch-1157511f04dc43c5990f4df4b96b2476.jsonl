re":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"the nanny is entertaining the children by making geomteric shapes out of nothing","start":1018,"end":1098,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The nanny is a warm presence I never fully observe, but the shapes she makes have the children rolling around the ground in stitches of laughter","start":1100,"end":1244,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:shapes made from nothing","other:children rolling around the ground"],"geometry":["other:geomteric shapes"],"material":["other:made out of nothing"],"density":[],"scale":[],"affect":["other:warmth","amusement"],"transition_trigger":[],"place":"other:unknown, not the kitchen"}},{"place":"back with the family","order":3,"light":[],"colour":[],"motion":["electric current running through me"],"geometry":["a shape"],"material":[],"density":[],"scale":[],"beings":[{"form":["the family"],"count_text":"they","behaviour":["made a shape","hit me with psychic uncontrollable laughter"],"communication":["took this as a question","rather than answer it, hit me with some psychic uncontrollable laugher"],"affect":[],"normalised":{"form":["other:the family"],"behaviour":["other:made a shape","other:hit me with psychic uncontrollable laughter"],"communication":["other:took this as a question","other:rather than answer it, hit me with some psychic uncontrollable laugher"],"affect":[]}}],"transition_trigger":["opening my eyes"],"affect":["uncontrollable laughter","concern","gratitude when it ended"],"quotes":[{"text":"in my mind I questioned how this was possible","start":1421,"end":1466,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"hit me with some psychic uncontrollable laugher, like a mental bomb","start":1524,"end":1591,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was a vessel through which the funniest sound ever was resonating","start":1864,"end":1931,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It was like an electric current running through me that I couldn't stop","start":1990,"end":2061,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was concerned I would wake my friendly elderly neighbour","start":2162,"end":2220,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:electric current running through me"],"geometry":["other:a shape"],"material":[],"density":[],"scale":[],"affect":["other:uncontrollable laughter","other:concern","other:gratitude when it ended"],"transition_trigger":["other:opening my eyes"],"place":"other:back with the family"}},{"place":"a supermarket / shopping centre","order":4,"light":[],"colour":["very white"],"motion":["general bustle","going about their shopping"],"geometry":["thin separating membrane"],"material":["membrane"],"density":["bustle of entities"],"scale":["two universes side by side"],"beings":[{"form":["entities"],"count_text":"a general bustle","behaviour":["shopping","putting items in grocery baskets"],"communication":[],"affect":[],"normalised":{"form":["other:entities"],"behaviour":["other:shopping","other:putting items in grocery baskets"],"communication":[],"affect":[]}},{"form":["A female guide like a customer services agent"],"count_text":"a","behaviour":["explains where I am","shows me how the shopping centre works"],"communication":["explains that this universe exists right beside mine"],"affect":[],"normalised":{"form":["other:A female guide like a customer services agent"],"behaviour":["other:explains where I am","other:shows me how the shopping centre works"],"communication":["other:explains that this universe exists right beside mine"],"affect":[]}}],"transition_trigger":[],"affect":["a lot to take in"],"quotes":[{"text":"I am now in a supermarket, again very white","start":2366,"end":2409,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"There is a general bustle of entities going about their shopping, putting items in grocery baskets","start":2411,"end":2509,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"A female guide like a customer services agent explains to me where I am","start":2511,"end":2582,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"She explains that this universe exists right beside mine and that the separating membrane is very thin","start":2627,"end":2729,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I go between the two and can see this shopping centre and my living room side by side with the thin membrane keeping them apart","start":2749,"end":2876,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:very white"],"motion":["other:general bustle","other:going about their shopping"],"geometry":["other:thin separating membrane"],"material":["other:membrane"],"density":["other:bustle of entities"],"scale":["other:two universes side by side"],"affect":["other:a lot to take in"],"transition_trigger":[],"place":"other:a supermarket / shopping centre"}}],"flags":["unmapped:/scenes/0/light","unmapped:/scenes/0/motion","unmapped:/scenes/0/geometry","unmapped:/scenes/0/scale","unmapped:/scenes/0/affect","unmapped:/scenes/0/place","unmapped:/scenes/0/beings/0/form","unmapped:/scenes/0/beings/0/behaviour","unmapped:/scenes/0/beings/0/communication","unmapped:/scenes/0/beings/0/affect","unmapped:/scenes/0/beings/1/form","unmapped:/scenes/0/beings/1/behaviour","unmapped:/scenes/0/beings/1/affect","unmapped:/scenes/1/motion","unmapped:/scenes/1/geometry","unmapped:/sce