{"report_id":"1xenr2","is_trip_report":true,"reason":"Writer recounts their own first experience, with room transforming and a field vision.","scenes":[{"place":"my room / bed","order":1,"light":[],"colour":["perfect blue sky"],"motion":["transforming","launching"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["vision deepening, guided by music"],"affect":["adrenaline","shivering with pure energy"],"quotes":[{"text":"my room begain to transform into some ideal perfect blue sky and adrenaline was pumping through my body, I was shivering with pure energy.","start":680,"end":818,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was launched (not breakthrough)","start":642,"end":675,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:perfect blue sky"],"motion":["other:transforming","other:launching"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:adrenaline","other:shivering with pure energy"],"transition_trigger":["other:vision deepening, guided by music"],"place":"other:my room / bed"}},{"place":"a beautiful green field","order":2,"light":[],"colour":["green"],"motion":[],"geometry":["rough outlines of posters"],"material":["grass"],"density":[],"scale":[],"beings":[],"transition_trigger":["coming down, regaining motor control"],"affect":["awe","respect"],"quotes":[{"text":"my vision almost completely took me to a beatiful green field where I was on my back in the grass","start":945,"end":1042,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"My posters I could see the rough oultlines of of, but no distinguishing characteristics.","start":1044,"end":1132,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"As I came down I gained more motor control and the colors and world I had entered left me behind.","start":119