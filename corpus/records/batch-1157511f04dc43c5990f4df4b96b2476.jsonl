{"report_id":"1uovon","is_trip_report":true,"reason":"Although mainly asking for advice, the writer briefly recounts a past personal DMT experience with visuals.","scenes":[{"place":"with a group of friends","order":1,"light":[],"colour":[],"motion":[],"geometry":["pretty shapes"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["trancedental beautiful"],"quotes":[{"text":"i have done dmt once before and I have got to say it was such a trancedental beautiful experience","start":58,"end":155,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"it was basically just pretty shapes and awesome visuals at that point","start":235,"end":304,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"the first time i was with a group of friends","start":816,"end":860,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":["other:pretty shapes"],"material":[],"density":[],"scale":[],"affect":["other:trancedental beautiful"],"transition_trigger":[],"place":"other:with a group of friends"}}],"flags":["unmapped:/scenes/0/geometry","unmapped:/scenes/0/affect","unmapped:/scenes/0/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-1157511f04dc43c5990f4df4b96b2476","phase":"pilot200","attempt":18}}
