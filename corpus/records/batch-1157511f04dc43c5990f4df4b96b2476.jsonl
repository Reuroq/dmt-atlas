{"report_id":"1wnquc","is_trip_report":true,"reason":"The writer recounts personal experiences including bodily unease and visual movement on walls and a painting.","scenes":[{"place":"","order":1,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["continuing to [redacted] further hits"],"affect":["paranoid","heavy","not enjoyable"],"quotes":[{"text":"After one hit i felt pretty paranoid and heavy...I was aware of the feelings of my chest and breath and every decision I made even the simplest movements and functions seemed to require a large amount of energy, it was not enjoyable","start":27,"end":259,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:paranoid","other:heavy","other:not enjoyable"],"transition_trigger":["other:continuing to [redacted] further hits"],"place":"other:"}},{"place":"room with plain white walls and an Alex Grey painting","order":2,"light":[],"colour":["plain white walls"],"motion":["beautiful movement"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["awesome and fun","hesitant/scared"],"quotes":[{"text":"although i kept my eyes open I saw beautiful movement in plain white walls and Alex Grey painting","start":356,"end":453,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"if i continue to take hit 2 and 3 then it becomes pretty awesome and fun","start":534,"end":606,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:plain white walls"],"motion":["other:beautiful movement"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:awesome and fun","other:hesitant/scared"],"transition_trigger":[],"place":"other:room with plain white walls and an Alex G