{"report_id":"1uxo7v","is_trip_report":true,"reason":"Firsthand account of two breakthrough experiences with detailed visions and entities.","scenes":[{"place":"friend's apartment, lying under a ceiling fan","order":1,"light":["three pronged lights","comforting lights"],"colour":[],"motion":["vision melting","fan kept spinning","slowing down"],"geometry":["patterns and fractals"],"material":[],"density":["overwhelming"],"scale":[],"beings":[],"transition_trigger":["closed my eyes"],"affect":["comfort","peace and tranquility","bursting laughter"],"quotes":[{"text":"my vision started to melt","start":467,"end":492,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"A continuous and increasing hum tuned out everything else","start":665,"end":722,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The fan above me kept spinning and I found comfort in it.","start":759,"end":816,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The three pronged lights represented something like a God that was going to guide me through this.","start":885,"end":983,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I couldn't help burst out laughing as I saw the visuals and patterns and fractals overwhelm my vision. And then I closed my eyes.","start":1027,"end":1156,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:three pronged lights","other:comforting lights"],"colour":[],"motion":["other:vision melting","other:fan kept spinning","other:slowing down"],"geometry":["other:patterns and fractals"],"material":[],"density":["other:overwhelming"],"scale":[],"affect":["other:comfort","other:peace and tranquility","other:bursting laughter"],"transition_trigger":["other:closed my eyes"],"place":"other:friend's apartment, lying under a ceiling fan"}},{"place":"the cosmos / hyperspace","order":2,"light":["technicolored explosion"],"colour":["most vivid explosions of colors"],"motion":["flying from plane to plane","floating back"],"geometry":[],"material":["molecules melted"],"density":[],"scale":["encompassed my entire consciousness","eternity"],"beings":[{"form":["elves","Robotic","Alien","Foreign","Friendly","machine elves"],"count_text":"the elves","behaviour":["surrounded my body","took me away","floated me back into reality"],"communication":["I heard a voice tell me if I wanted to die"],"affect":["Friendly"],"normalised":{"form":["self-transforming-machine-elves","robotic","alien-grey-forms","other:Foreign","other:Friendly","self-transforming-machine-elves"],"behaviour":["other:surrounded my body","other:took me away","other:floated me back into reality"],"communication":["other:I heard a voice tell me if I wanted to die"],"affect":["other:Friendly"]}}],"transition_trigger":["elves floated me back into reality","opening my eyes"],"affect":["excited","good kind of pain","oneness"],"quotes":[{"text":"A technicolored explosion of the universe encompassed my entire consciousness","start":1168,"end":1245,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was flying from plane to plane, existence to existence. Then I saw the elves. Robotic. Alien. Foreign. Friendly.","start":1451,"end":1565,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"A felt sharp pressure in my upper chest. It was painful but it was a good kind of pain.","start":1600,"end":1687,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I heard a voice tell me if I wanted to die.","start":1688,"end":1731,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"My body melted and the molecules simply melted into the cosmos and I became one.","start":1780,"end":1860,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"the elves started to float me back into reality","start":2038,"end":2085,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:technicolored explosion"],"colour":["other:most vivid explosions of colors"],"motion":["other:flying from plane to plane","other:floating back"],"geometry":[],"material":["other:molecules melted"],"density":[],"scale":["other:encompassed my entire consciousness","other:eternity"],"affect":["other:excited","other:good kind of pain","other:oneness"],"transition_trigger":["other:elves floated me back into reality","other:opening my eyes"],"place":"other:the cosmos / hyperspace"}},{"place":"back in the room with the fan","order":3,"light":["The comforting lights"],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["second attempt later, lights turned off"],"affect":["laughter","amazement","beauty"],"quotes":[{"text":"I remember opening my eyes and seeing the fan above me. The comforting lights. I could not help but laugh and laugh and laugh.","start":2088,"end":2214,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I had so many questions yet I felt I had all the answers.","start":2296,"end":2353,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:The comforting lights"],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:laughter","other:amazement","other:beauty"],"transition_trigger":["other:second attempt later, lights turned off"],"place":"other:back in the room with the fan"}},{"place":"floor of some surface, in darkness","order":4,"light":["lights turned off","darkness"],"colour":[],"motion":[],"geometry":[],"material":[],"density":["surrounded"],"scale":[],"beings":[{"form":["evil jester faces","demons"],"count_text":"surrounded by demons","behaviour":["laughing at me with malicious intent","trying to suck out my consciousness","trying to drive a lance through my chest"],"communication":["Screaming \"DO YOU WANT TO DIE?\""],"affect":["malicious intent"],"normalised":{"form":["other:evil jester faces","dark-entities-demons"],"behaviour":["other:laughing at me with malicious intent","other:trying to suck out my consciousness","other:trying to drive a lance through my chest"],"communication":["other:Screaming \"DO YOU WANT TO DIE?\""],"affect":["other:malicious intent"]}}],"transition_trigger":["screamed no, spotter turned on the lights"],"affect":["terrified","helpless","despair","spiritually defeated"],"quotes":[{"text":"I let a single thought of ill will manifest itself into a nightmare of demons.","start":3089,"end":3167,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I closed my eyes and felt myself on the floor of some surface.","start":3168,"end":3230,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I saw evil jester faces laughing at me with such malicious intent. I was terrified.","start":3231,"end":3314,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was surrounded by demons trying to suck out my consciousness.","start":3425,"end":3488,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Above me was an evil jester trying to drive a lance through my chest. Screaming \"DO YOU WANT TO DIE?\"","start":3515,"end":3616,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I sat back up and all I felt was despair.","start":3808,"end":3849,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:lights turned off","other:darkness"],"colour":[],"motion":[],"geometry":[],"material":[],"density":["other:surrounded"],"scale":[],"affect":["other:terrified","other:helpless","other:despair","other:spiritually defeated"],"transition_trigger":["other:screamed no, spotter turned on the lights"],"place":"other:floor of some surface, in darkness"}}],"flags":["unmapped:/scenes/0/light","unmapped:/scenes/0/motion","unmapped:/scenes/0/geometry","unmapped:/scenes/0/density","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/1/light","unmapped:/scenes/1/colour","unmapped:/scenes/1/motion","unmapped:/scenes/1/material","unmapped:/scenes/1/scale","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/1/beings/0/form","unmapped:/scenes/1/beings/0/behaviour","unmapped:/scenes/1/beings/0/communication","unmapped:/scenes/1/beings/0/affect","unmapped:/scenes/2/light","unmapped:/scenes/2/affect","unmapped:/scenes/2/transition_trigger","unmapped:/scenes/2/place","unmapped:/scenes/3/light","unmapped:/scenes/3/density","unmapped:/scenes/3/affect","unmapped:/scenes/3/transition_trigger","unmapped:/scenes/3/place","unmapped:/scenes/3/beings/0/form","unmapped:/scenes/3/beings/0/behaviour","unmapped:/scenes/3/beings/0/communication","unmapped:/scenes/3/beings/0/affect"],"schema_version":"0.4.0","_extraction":{"job":"batch-1157511f04dc43c5990f4df4b96b2476","phase":"pilot200","attempt":18}}
