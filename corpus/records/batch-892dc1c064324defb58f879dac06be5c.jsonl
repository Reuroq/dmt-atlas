{"report_id":"20erf9","is_trip_report":true,"reason":"The writer recounts their own first experiences yesterday with visions of geometry, a smiling face, and afterglow visuals.","scenes":[{"place":"","order":1,"light":[],"colour":["changing colors","overwhelming emerald green"],"motion":["shifting","vibrating","morphing"],"geometry":["geometric patterns"],"material":["made entirely of these geometric patterns"],"density":[],"scale":[],"beings":[{"form":["figures morphed out of the geometry","recognizable form"],"count_text":"any figures that I saw","behaviour":["morphing out of geometry"],"communication":[],"affect":[],"normalised":{"form":["other:figures morphed out of the geometry","other:recognizable form"],"behaviour":["other:morphing out of geometry"],"communication":[],"affect":[]}},{"form":["shadowy black figures"],"count_text":"a lot of","behaviour":[],"communication":[],"affect":[],"normalised":{"form":["other:shadowy black figures"],"behaviour":[],"communication":[],"affect":[]}}],"transition_trigger":[],"affect":["beautiful","peaceful","extremely confused, uncomfortable"],"quotes":[{"text":"All that I saw was a bunch of geometric patterns shifting, vibrating, morphing, or changing colors.","start":256,"end":355,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"And any figures that I saw just morphed out of this geometry.","start":356,"end":417,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"All three trips, I saw an overwhelming amount of emerald green.","start":1103,"end":1166,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I saw a lot of shadowy black figures that I suppose are supposed to be like guides or something.","start":1182,"end":1278,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"There was a point where I was extremely confused, and that was uncomfortable.","start":1280,"end":1357,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:changing colors","other:overwhelming emerald green"],"motion":["other:shifting","vibrating","morphing"],"geometry":["other:geometric patterns"],"material":["other:made entirely of these geometric patterns"],"density":[],"scale":[],"affect":["other:beautiful","calm","other:extremely confused, uncomfortable"],"transition_trigger":[],"place":"other:"}},{"place":"that realm","order":2,"light":[],"colour":[],"motion":["flew right through me"],"geometry":[],"material":["like a ghost"],"density":[],"scale":[],"beings":[{"form":["just a face, no body"],"count_text":"something","behaviour":["flew right through me","gave sensation of being hugged"],"communication":[],"affect":["largest smile","blissfully soaking up the peace"],"normalised":{"form":["other:just a face, no body"],"behaviour":["other:flew right through me","other:gave sensation of being hugged"],"communication":[],"affect":["other:largest smile","other:blissfully soaking up the peace"]}}],"transition_trigger":["coming down, closing eyes again"],"affect":["peaceful"],"quotes":[{"text":"It was just a face, no body or anything. It had the largest smile I've ever seen, and closed eyes, as if it was also just blissfully soaking up the peace of that realm.","start":546,"end":714,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It flew right through me, like a ghost flying through a wall, and it gave me the sensation of being hugged.","start":715,"end":822,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:flew right through me"],"geometry":[],"material":["other:like a ghost"],"density":[],"scale":[],"affect":["calm"],"transition_trigger":["other:coming down, closing eyes again"],"place":"other:that realm"}},{"place":"closed-eye field of view after coming down","order":3,"light":["blindingly bright white light"],"colour":["rainbows"],"motion":["encircling"],"geometry":["circular, centered"],"material":[],"density":[],"scale":["big"],"beings":[{"form":["a big smiling mouth"],"count_text":"a big smiling mouth","behaviour":["in the middle of the light"],"communication":[],"affect":["smile made me feel peaceful"],"normalised":{"form":["other:a big smiling mouth"],"behaviour":["other:in the middle of the light"],"communication":[],"affect":["other:smile made me feel peaceful"]}}],"transition_trigger":[],"affect":["peaceful"],"quotes":[{"text":"I closed my eyes again and saw rainbows encircling my field of view.","start":843,"end":911,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"In the center was just this blindingly bright white light, and a big smiling mouth in the middle of it.","start":912,"end":1015,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I came back down and loved watching the trails that would happen when I waved my hands in front of my face!","start":1427,"end":1534,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:blindingly bright white light"],"colour":["other:rainbows"],"motion":["other:encircling"],"geometry":["other:circular, centered"],"material":[],"density":[],"scale":["other:big"],"affect":["calm"],"transition_trigger":[],"place":"other:closed-eye field of view after coming down"}}],"flags":["unmapped:/scenes/0/colour","unmapped:/scenes/0/motion","unmapped:/scenes/0/geometry","unmapped:/scenes/0/material","unmapped:/scenes/0/affect","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place","unmapped:/scenes/0/beings/0/form","unmapped:/scenes/0/beings/0/behaviour","unmapped:/scenes/0/beings/1/form","unmapped:/scenes/1/motion","unmapped:/scenes/1/material","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/1/beings/0/form","unmapped:/scenes/1/beings/0/behaviour","unmapped:/scenes/1/beings/0/affect","unmapped:/scenes/2/light","unmapped:/scenes/2/colour","unmapped:/scenes/2/motion","unmapped:/scenes/2/geometry","unmapped:/scenes/2/scale","unmapped:/scenes/2/place","unmapped:/scenes/2/beings/0/form","unmapped:/scenes/2/beings/0/behaviour","unmapped:/scenes/2/beings/0/affect"],"schema_version":"0.4.0","_extraction":{"job":"batch-892dc1c064324defb58f879dac06be5c","phase":"pilot200","attempt":19}}
