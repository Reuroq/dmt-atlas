{"report_id":"20runj","is_trip_report":true,"reason":"First-person account of a DMT experience with tunnel, colours, and return to the room.","scenes":[{"place":"","order":1,"light":[],"colour":["colors that can't be imagined"],"motion":["racing through"],"geometry":["diamond geometric tunnel"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["loss of body, fading from reality"],"affect":["unexpected"],"quotes":[{"text":"before I could exhale, I was racing through a diamond geometric tunnel","start":287,"end":357,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I saw colors that can't be imagined","start":610,"end":645,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I lost control of my body quickly after inhaling- I just felt myself go limp and fade away from this reality","start":731,"end":839,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:colors that can't be imagined"],"motion":["other:racing through"],"geometry":["other:diamond geometric tunnel"],"material":[],"density":[],"scale":[],"affect":["other:unexpected"],"transition_trigger":["other:loss of body, fading from reality"],"place":"other:"}},{"place":"","order":2,"light":[],"colour":[],"motion":["cyclic"],"geometry":[],"material":[],"density":[],"scale":["10,000 years or possibly a millisecond","every moment that has ever happened"],"beings":[],"transition_trigger":["choosing death","waking back in body"],"affect":["terrifying","most pleasurable","humbled"],"quotes":[{"text":"I went to heaven. I went to hell. I lived every moment that has ever happened and will ever happen.","start":359,"end":458,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was in a very cyclic state that was terrifying. It felt as if the only way to end it was to choose death.","start":841,"end":948,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"After 10,000 years or possibly a millisecond (my clock said 30 minutes), I woke up in my body again.","start":1029,"end":1129,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:cyclic"],"geometry":[],"material":[],"density":[],"scale":["other:10,000 years or possibly a millisecond","other:every moment that has ever happened"],"affect":["other:terrifying","other:most pleasurable","other:humbled"],"transition_trigger":["other:choosing death","other:waking back in body"],"place":"other:"}},{"place":"on the floor / rug in the room","order":3,"light":["halos"],"colour":["most beautiful color I had ever seen","Unreal color"],"motion":[],"geometry":["triangular geometric halos around everything"],"material":[],"density":[],"scale":[],"beings":[{"form":["trip-sitter"],"count_text":"","behaviour":["held my hand","laughed along"],"communication":["I said \"I love you\""],"affect":[],"normalised":{"form":["other:trip-sitter"],"behaviour":["other:held my hand","other:laughed along"],"communication":["other:I said \"I love you\""],"affect":[]}}],"transition_trigger":[],"affect":["laughing and crying","happiness","pure unfiltered love","confusion"],"quotes":[{"text":"I laid in the floor laughing and crying for about 20 minutes","start":1130,"end":1190,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"the remnants of DMT land could be seen in triangular geometric halos around everything in the room, and the rug I was lying on was the most beautiful color I had ever seen. Unreal color.","start":1309,"end":1495,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"My trip-sitter held my hand, and laughed along with me.","start":1614,"end":1669,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"The first thing I said to my sitter was \"I love you\"","start":1757,"end":1809,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:halos"],"colour":["other:most beautiful color I had ever seen","other:Unreal color"],"motion":[],"geometry":["other:triangular geometric halos around everything"],"material":[],"density":[],"scale":[],"affect":["other:laughing and crying","other:happiness","other:pure unfiltered love","confusion"],"transition_trigger":[],"place":"other:on the floor / rug in the room"}}],"flags":["unmapped:/scenes/0/colour","unmapped:/scenes/0/motion","unmapped:/scenes/0/geometry","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place","unmapped:/scenes/1/motion","unmapped:/scenes/1/scale","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","empty_descriptor:/scenes/1/place","unmapped:/scenes/1/place","unmapped:/scenes/2/light","unmapped:/scenes/2/colour","unmapped:/scenes/2/geometry","unmapped:/scenes/2/affect","unmapped:/scenes/2/place","unmapped:/scenes/2/beings/0/form","unmapped:/scenes/2/beings/0/behaviour","unmapped:/scenes/2/beings/0/communication"],"schema_version":"0.4.0","_extraction":{"job":"batch-892dc1c064324defb58f879dac06be5c","phase":"pilot200","attempt":19}}
{"report_id":"21rv3x","is_trip_report":true,"reason":"First-person account of a psychedelic experience with timeline, visuals and bodily effects.","scenes":[{"place":"dark bedroom","order":1,"light":["dark room"],"colour":[],"motion":["jerky motor functions"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["settling onto bed with music"],"affect":["paranoia","fear"],"quotes":[{"text":"first thing that happened was paranoia, I was scared of the window and jerky motor functions","start":560,"end":652,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was scared of the open window so i struggled to get up and close it (the room was also dark)","start":654,"end":748,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:dark room"],"colour":[],"motion":["other:jerky motor functions"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:paranoia","fear"],"transition_trigger":["other:settling onto bed with music"],"place":"other:dark bedroom"}},{"place":"on bed","order":2,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["effects peaked"],"affect":[],"quotes":[{"text":"Listening to the music, crawled up on my bed, some psychological effects are there, blurry vision","start":757,"end":854,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":[],"transition_trigger":["other:effects peaked"],"place":"other:on bed"}},{"place":"bedroom walls","order":3,"light":["visible even in the dark"],"colour":[],"motion":[],"geometry":["fractals"],"material":[],"density":["all over the walls"],"scale":[],"beings":[],"transition_trigger":["trip took a dark turn"],"affect":[],"quotes":[{"text":"I started seeing some fractals on the wall, fractals all over the walls in my bedroom, even in the dark, i closed my eyes and could see some closed eye hallucinations, but not really that visual","start":943,"end":1137,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:visible even in the dark"],"colour":[],"motion":[],"geometry":["other:fractals"],"material":[],"density":["other:all over the walls"],"scale":[],"affect":[],"transition_trigger":["other:trip took a dark turn"],"place":"other:bedroom walls"}},{"place":"closed-eye visions on bed","order":4,"light":[],"colour":[],"motion":["body jerking and convulsing"],"geometry":["fractals of skulls and skeletons"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["struck by an immense force"],"affect":["scared","wanting to go back"],"quotes":[{"text":"my body was jerking and convulsing constantly","start":1272,"end":1317,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"whenever I close my eyes i saw fractals of skulls and skeletons (similar to the ones in the mexican festival of the dead)","start":1377,"end":1498,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I was scared at this point and all i was thinking was \"I want to go back\"","start":1499,"end":1572,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:body jerking and convulsing"],"geometry":["other:fractals of skulls and skeletons"],"material":[],"density":[],"scale":[],"affect":["other:scared","other:wanting to go back"],"transition_trigger":["other:struck by an immense force"],"place":"other:closed-eye visions on bed"}},{"place":"","order":5,"light":[],"colour":[],"motion":["dragging or pulling down","moving upward from feet to head"],"geometry":["fractal vision shattered"],"material":[],"density":[],"scale":["immense"],"beings":[],"transition_trigger":["visuals ended"],"affect":["awe","hope for breakthrough"],"quotes":[{"text":"I was then struck by an immense force, or a microseizure, not sure which","start":1684,"end":1756,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It started at my feet, this immense force, an energy that I felt was almost dragging me or pulling me down, then it moved to my waist and after that it reached my head and all my music turned into a blurry noise and he fractal vision was shattered","start":1946,"end":2193,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"At each time I was hoping this would be my break through but it didn't happen","start":2222,"end":2299,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:dragging or pulling down","other:moving upward from feet to head"],"geometry":["other:fractal vision shattered"],"material":[],"density":[],"scale":["other:immense"],"affect":["awe","other:hope for breakthrough"],"transition_trigger":["other:visuals ended"],"place":"other:"}},{"place":"bathroom mirror","order":6,"light":[],"colour":["seeing colors for the first time"],"motion":["still convulsing abit"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["able to walk and talk again"],"affect":["disappointment","surprise"],"quotes":[{"text":"No more visuals, closed or otherwise, but I was still convulsing abit and had some nausea, i was disappointed because I expected much more","start":2307,"end":2445,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I looked at myself in the mirror and was surprised to see everything in HD","start":2492,"end":2566,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I had completely lost my ability to speak","start":2709,"end":2750,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:seeing colors for the first time"],"motion":["other:still convulsing abit"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:disappointment","surprise"],"transition_trigger":["other:able to walk and talk again"],"place":"other:bathroom mirror"}},{"place":"","order":7,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["euphoric mood","laughter","dissatisfaction"],"quotes":[{"text":"Able to walk and talk now, (abit messy though) euphoric mood, laughter.","start":2931,"end":3002,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"this really didn't go the distance for me","start":3102,"end":3143,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:euphoric mood","other:laughter","other:dissatisfaction"],"transition_trigger":[],"place":"other:"}}],"flags":["unmapped:/scenes/0/light","unmapped:/scenes/0/motion","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/2/light","unmapped:/scenes/2/geometry","unmapped:/scenes/2/density","unmapped:/scenes/2/transition_trigger","unmapped:/scenes/2/place","unmapped:/scenes/3/motion","unmapped:/scenes/3/geometry","unmapped:/scenes/3/affect","unmapped:/scenes/3/transition_trigger","unmapped:/scenes/3/place","unmapped:/scenes/4/motion","unmapped:/scenes/4/geometry","unmapped:/scenes/4/scale","unmapped:/scenes/4/affect","unmapped:/scenes/4/transition_trigger","empty_descriptor:/scenes/4/place","unmapped:/scenes/4/place","unmapped:/scenes/5/colour","unmapped:/scenes/5/motion","unmapped:/scenes/5/affect","unmapped:/scenes/5/transiti