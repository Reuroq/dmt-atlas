{"report_id":"1zlhts","is_trip_report":true,"reason":"First-person account of visual and cognitive distortions during a specific experience.","scenes":[{"place":"his room at desk","order":1,"light":[],"colour":[],"motion":["patterns quickly appearing"],"geometry":["grid-like patterns","polka dots"],"material":["textures on everything"],"density":[],"scale":[],"beings":[],"transition_trigger":["objects becoming foreign/unrecognizable"],"affect":[],"quotes":[{"text":"Within seconds of taking the full hit, patterns and textures quickly appeared on everything.","start":348,"end":440,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Grid-like patterns on my desk, polka dots on my bong, etc.","start":441,"end":499,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:patterns quickly appearing"],"geometry":["other:grid-like patterns","other:polka dots"],"material":["other:textures on everything"],"density":[],"scale":[],"affect":[],"transition_trigger":["other:objects becoming foreign/unrecognizable"],"place":"other:his room at desk"}},{"place":"his room","order":2,"light":[],"colour":["floor took on a different color"],"motion":["things literally becoming other things","furniture changing"],"geometry":["different pattern on floor"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["apparent voice about cops"],"affect":["alienation","could not identify anything"],"quotes":[{"text":"objects becoming extremely foreign and alien like to me. I could not identify anything AT ALL.","start":537,"end":631,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I remember looking at some text on my computer and it was in an alien language.","start":780,"end":859,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"During the peak of my trip my room was changing A LOT.","start":861,"end":915,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I also think furniture was even changing into different unrecognizable things.","start":1016,"end":1094,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["other:floor took on a different color"],"motion":["other:things literally becoming other things","other:furniture changing"],"geometry":["other:different pattern on floor"],"material":[],"density":[],"scale":[],"affect":["other:alienation","other:could not identify anything"],"transition_trigger":["other:apparent voice about cops"],"place":"other:his room"}},{"place":"his room","order":3,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[{"form":["possible cops, uncertain if real"],"count_text":"","behaviour":["possibly questioning him in his room"],"communication":["\"Dude the cops are here\""],"affect":[],"normalised":{"form":["other:possible cops, uncertain if real"],"behaviour":["other:possibly questioning him in his room"],"communication":["other:\"Dude the cops are here\""],"affect":[]}}],"transition_trigger":["coming back to reality"],"affect":["panic","uncertainty about what was real"],"quotes":[{"text":"At some point I got the idea that someone said \"Dude the cops are here\". I started panicking","start":1096,"end":1188,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"For about 30 seconds it was very hard to tell what was real because I made myself think I was hearing the house alarm going off and cops were outside.","start":1490,"end":1640,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["panic","other:uncertainty about what was real"],"transition_trigger":["other:coming back to reality"],"place":"other:his room"}},{"place":"his room, coming down","order":4,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["confusion"],"quotes":[{"text":"I grabbed some socks but had no knowledge on what to do with them. I know they go on my feet but HOW??","start":1726,"end":1828,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["confusion"],"transition_trigger":[],"place":"other:his room, coming down"}}],"flags":["unmapped:/scenes/0/motion","unmapped:/scenes/0/geometry","unmapped:/scenes/0/material","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/1/colour","unmapped:/scenes/1/motion","unmapped:/scenes/1/geometry","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1/place","unmapped:/scenes/2/affect","unmapped:/scenes/2/transition_trigger","unmapped:/scenes/2/place","unmapped:/scenes/2/beings/0/form","unmapped:/scenes/2/beings/0/behaviour","unmapped:/scenes/2/beings/0/communication","unmapped:/scenes/3/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-892dc1c064324defb58f879dac06be5c","phase":"pilot200","attempt":19}}
{"report_id":"1z6no1","is_trip_report":true,"reason":"The writer recounts personal sessions, including last night's, describing feeling blocked from breaking through.","scenes":[{"place":"","order":1,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["best experience","near-breakthrough"],"quotes":[{"text":"Probably the best experience I had.  I think my closest to a breakthrough to date.","start":99,"end":181,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:best experience","other:near-breakthrough"],"transition_trigger":[],"place":"other:"}},{"place":"his session, last night","order":2,"light":[],"colour":[],"motion":[],"geometry":["barrier that can't be broken"],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["feeling left out","longing"],"quotes":[{"text":"Last night in my session I left like I was being left out.","start":521,"end":579,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"You've seen the wonders and want to continue but you can't break the barrier.","start":581,"end":658,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":["other:barrier that can't be broken"],"material":[],"density":[],"scale":[],"affect":["other:feeling left out","other:longing"],"transition_trigger":[],"place":"other:his session, last night"}}],"flags":["unmapped:/scenes/0/affect","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place","unmapped:/scenes/1/geometry","unmapped:/scenes/1/affect","unmapped:/scenes/1/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-892dc1c064324defb58f879dac06be5c","phase":"pilot200","attempt":19}}
{"report_id":"22arby","is_trip_report":true,"reason":"First-person account of a DMT experience with visual and bodily changes.","scenes":[{"place":"apartment, brown carpet","order":1,"light":[],"colour":[],"motion":["writhed and throbbed","to the beat of music"],"geometry":["coiled, tentacled, geometric pattern"],"material":["carpet"],"density":[],"scale":[],"beings":[],"transition_trigger":["another hit"],"affect":["surprise","a little overwhelmed","light and airy"],"quotes":[{"text":"The brown carpet instantly took on a coiled, tentacled, geometric pattern that writhed and throbbed to the beat of GameFace’s Holy Ghost.","start":249,"end":386,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Weight seemed to fall off my body from my scalp down, leaving me light and airy.","start":387,"end":467,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"\"Oh god, everything is different,\" I said and I felt a little overwhelmed.","start":543,"end":617,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:writhed and throbbed","other:to the beat of music"],"geometry":["other:coiled, tentacled, geometric pattern"],"material":["other:carpet"],"density":[],"scale":[],"affect":["surprise","other:a little overwhelmed","other:light and airy"],"transition_trigger":["other:another hit"],"place":"other:apartment, brown carpet"}},{"place":"","order":2,"light":[],"colour":["white"],"motion":[],"geometry":[],"material":["static"],"density":[],"scale":[],"beings":[],"transition_trigger":["memory of past trip surfacing"],"affect":["delirious","confusion","laughing"],"quotes":[{"text":"I managed one more hit and then I felt delirious. I grabbed his wrist but then I was gone, white noise and static.","start":976,"end":1090,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It felt like I spent several minutes just trying to understand. Why was I like this?","start":1127,"end":1211,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"There was no context.","start":1584,"end":1605,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":["white"],"motion":[],"geometry":[],"material":["other:static"],"density":[],"scale":[],"affect":["other:delirious","confusion","other:laughing"],"transition_trigger":["other:memory of past trip surfacing"],"place":"other:"}},{"place":"apartment (felt like back in February)","order":3,"light":[],"colour":[],"motion":["around and around"],"geometry":["mirrored parallel walls","maze","carousel"],"material":[],"density":[],"scale":[],"beings":[{"form":["sirens","taunting voices in the music"],"count_text":"","behaviour":["serenading"],"communication":["repetitive and taunting voices and melody"],"affect":["sinister"],"normalised":{"form":["fairies-sirens-seductresses","other:taunting voices in the music"],"behaviour":["other:serenading"],"communication":["other:repetitive and taunting voices and melody"],"affect":["other:sinister"]}}],"transition_trigger":["looking across the room"],"affect":["confusion","lost"],"quotes":[{"text":"But then, for a moment, I thought I was back in February","start":1607,"end":1663,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Memories reflecting memories like mirrored parallel walls, losing myself in a psychological maze","start":1925,"end":2021,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"sirens serenading me to a sinister waltzing carnival carousel ride around and around.","start":2106,"end":2191,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I wanted to ask for help but I didn’t seem to be able to speak.","start":2193,"end":2256,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:around and around"],"geometry":["other:mirrored parallel walls","other:maze","other:carousel"],"material":[],"density":[],"scale":[],"affect":["confusion","other:lost"],"transition_trigger":["other:looking across the room"],"place":"other:apartment (felt like back in February)"}},{"place":"room, looking at carpet and oven","order":4,"light":["dazzlingly white surface"],"colour":["large colorful arrows"],"motion":["slithering"],"geometry":["arrows and dashed lines"],"material":[],"density":[],"scale":["large"],"beings":[{"form":["voice attributed to partner, words he never spoke"],"count_text":"","behaviour":["repeating reassurance"],"communication":["“Everything is different, but it won’t be forever. So just enjoy it. Isn’t it beautiful?”"],"affect":["comforting, soft"],"normalised":{"form":["other:voice attributed to partner, words he never spoke"],"behaviour":["other:repeating reassurance"],"communication":["other:“Everything is different, but it won’t be forever. So just enjoy it. Isn’t it beautiful?”"],"affect":["other:comforting, soft"]}}],"transition_trigger":["feeling much more coherent, rolling over"],"affect":["comforted","appreciation","beauty"],"quotes":[{"text":"I looked across the room at the slithering carpet, the oven decorated with large colorful arrows and dashed lines on a dazzlingly white surface.","start":2366,"end":2510,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"“Isn’t it beautiful?” My partner said from my side, and it was.","start":2511,"end":2574,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"He’d never actually spoken those words","start":3167,"end":3205,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:dazzlingly white surface"],"colour":["other:large colorful arrows"],"motion":["other:slithering"],"geometry":["other:arrows and dashed lines"],"material":[],"density":[],"scale":["large"],"affect":["other:comforted","other:appreciation","other:beauty"],"transition_trigger":["other:feeling much more coherent, rolling over"],"place":"other:room, looking at carpet and oven"}},{"place":"facing the blinded window","order":5,"light":["shone with a glossy rainbow like an oil slick"],"colour":["off-white","rainbow"],"motion":["leaned to the right","pooling"],"geometry":[],"material":["gel liquid","oil slick"],"density":[],"scale":[],"beings":[],"transition_trigger":["warmth and vibration"],"affect":["lazy smile"],"quotes":[{"text":"the off-white of which shone with a glossy rainbow like an oil slick","start":3570,"end":3638,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"My body was made of gel liquid, pooling in that direction, wet but not soaking into the sheets.","start":3698,"end":3793,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:shone with a glossy rainbow like an oil slick"],"colour":["other:off-white","other:rainbow"],"motion":["other:leaned to the right","other:pooling"],"geometry":[],"material":["other:gel liquid","other:oil slick"],"density":[],"scale":[],"affect":["other:lazy smile"],"transition_trigger":["other:warmth and vibration"],"place":"other:facing the blinded window"}},{"place":"","order":6,"light":[],"colour":[],"motion":["steady vibration increasing everywhere"],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["warmth","almost sexual","dreamy","shaking"],"quotes":[{"text":"Warmth enveloped my body, particularly my crotch, and with a steady vibration increasing everywhere, it felt almost sexual.","start":3964,"end":4087,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"while I was shaking severely, partly from the sudden chill it left me","start":4429,"end":4498,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:steady vibration increasing everywhere"],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:warmth","other:almost sexual","other:dreamy","other:shaking"],"transition_trigger":[],"place":"other:"}}],"flags":["unmapped:/scenes/0/motion","unmapped:/scenes/0/geometry","unmapped:/scenes/0/material","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","unmapped:/scenes/0/place","unmapped:/scenes/1/material","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","empty_descriptor:/scenes/1/place","unmapped:/scenes/1/place","unmapped:/scenes/2/motion","unmapped:/scenes/2/geometry","unmapped:/scenes/2/affect","unmapped:/scenes/2/transition_trigger","unmapped:/scenes/2/place","unmapped:/scenes/2/beings/0/form","unmapped:/scenes/2/beings/0/behaviour","unmapped:/scenes/2/beings/0/communication","unmapped:/scenes/2/beings/0/affect","unmapped:/scenes/3/light","unmapped:/scenes/3/colour","unmapped:/scenes/3/motion","unmapped:/scenes/3/geometry","unmapped:/scenes/3/affect","unmapped:/scenes/3/transition_trigger","unmapped:/scenes/3/place","unmapped:/scenes/3/beings/0/form","unmapped:/scenes/3/beings/0/behaviour","unmapped:/scenes/3/beings/0/communication","unmapped:/scenes/3/beings/0/affect","unmapped:/scenes/4/light","unmapped:/scenes/4/colour","unmapped:/scenes/4/motion","unmapped:/scenes/4/material","unmapped:/scenes/4/affect","unmapped:/scenes/4/transition_trigger","unmapped:/scenes/4/place","unmapped:/scenes/5/motion","unmapped:/scenes/5/affect","empty_descriptor:/scenes/5/place","unmapped:/scenes/5/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-892dc1c064324defb58f879dac06be5c","phase":"pilot200","attempt":19}}
