{"report_id":"zlujh","is_trip_report":true,"reason":"Writer recounts their own first trip with visual, temporal and identity changes.","scenes":[{"place":"","order":1,"light":["bright lights"],"colour":["colorful, like brighter Tron lights"],"motion":["fluid"],"geometry":[],"material":["fluid"],"density":[],"scale":[],"beings":[],"transition_trigger":["it turned for the next five minutes","I stepped back from my eyelids inside of my skull, and then my eyelids shut"],"affect":["incredible","connectivity"],"quotes":[{"text":"I had an amazing first minute of fluid and color (like brighter and more colorful Tron lights) and connectivity, but then it turned for the next five minutes","start":77,"end":234,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:bright lights"],"colour":["other:colorful, like brighter Tron lights"],"motion":["other:fluid"],"geometry":[],"material":["other:fluid"],"density":[],"scale":[],"affect":["other:incredible","other:connectivity"],"transition_trigger":["other:it turned for the next five minutes","other:I stepped back from my eyelids inside of my skull, and then my eyelids shut"],"place":"other:"}},{"place":"inside my head","order":2,"light":["chaotic and overwhelming flashing lights"],"colour":[],"motion":["flashing all around"],"geometry":[],"material":[],"density":["overwhelming"],"scale":["felt like a lifetime"],"beings":[],"transition_trigger":["took hold of Descartes' words","started to clear my head"],"affect":["terror","loss of identity","fear of being trapped forever"],"quotes":[{"text":"Chaotic and overwhelming lights were flashing all around me, and I lost grasp of my perception of time.","start":313,"end":416,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I lost grasp of reality, and eventually, my identity.","start":514,"end":567,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I thought I was going to end up there, and I was going to be trapped inside my head forever.","start":909,"end":1001,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":["other:chaotic and overwhelming flashing lights"],"colour":[],"motion":["other:flashing all around"],"geometry":[],"material":[],"density":["other:overwhelming"],"scale":["other:felt like a lifetime"],"affect":["other:terror","other:loss of identity","other:fear of being trapped forever"],"transition_trigger":["other:took hold of Descartes' words","other:started to clear my head"],"place":"other:inside my head"}},{"place":"","order":3,"light":[],"colour":[],"motion":[],"geometry":[],"material":["made of fluid"],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["happy","joy","beauty"],"quotes":[{"text":"That's when I started to clear my head and came back to what it was like the first minute, and it was incredible.","start":1173,"end":1286,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I felt like I was crying because I was so happy, but when I tried to wipe the tears away, I just pushed them into my face because I was made of fluid.","start":1287,"end":1437,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":["other:made of fluid"],"density":[],"scale":[],"affect":["other:happy","joy","other:beauty"],"transition_trigger":[],"place":"other:"}}],"flags":["unmapped:/scenes/0/light","unmapped:/scenes/0/colour","unmapped:/scenes/0/motion","unmapped:/scenes/0/material","unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place","unmapped:/scenes/1/light","unmapped:/scenes/1/motion","unmapped:/scenes/1/density","unmapped:/scenes/1/scale","unmapped:/scenes/1/affect","unmapped:/scenes/1/transition_trigger","unmapped:/scenes/1