{"report_id":"zy7fe","is_trip_report":true,"reason":"Writer recounts a personal intense experience and subsequent after-effects, including perceptual shifts.","scenes":[{"place":"","order":1,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[],"transition_trigger":["months passing"],"affect":["intense"],"quotes":[{"text":"A few months ago, I had a pretty intense experience; not a breakthrough, but intense enough.","start":58,"end":150,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["other:intense"],"transition_trigger":["other:months passing"],"place":"other:"}},{"place":"everyday life, months after","order":2,"light":[],"colour":[],"motion":["eyes swoop around","watching my head and hands move independently"],"geometry":[],"material":["body felt like a figment"],"density":[],"scale":[],"beings":[],"transition_trigger":[],"affect":["anxiety attacks","incredibly concerned","disorienting","scary"],"quotes":[{"text":"I find myself asking myself unsettlingly unanswerable questions about reality, ultimately manifesting in anxiety attacks","start":349,"end":469,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I get incredibly concerned that my body is a figment, my reality is contrived, and I am eternally on the cusp of a total breakdown of my reality","start":554,"end":698,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I feel my eyes move behind my body, like I'm watching my head and hands move independently","start":700,"end":790,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Sometimes my eyes will swoop around for a second, and it's very disorienting.","start":792,"end":869,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":["other:eyes swoop around","other:watching my head and hands move independently"],"geometry":[],"material":["other:body felt like a figment"],"density":[],"scale":[],"affect":["other:anxiety attacks","other:incredibly concerned","other:disorienting","other:scary"],"transition_trigger":[],"place":"other:everyday life, months after"}}],"flags":["unmapped:/scenes/0/affect","unmapped:/scenes/0/transition_trigger","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place","unmapped:/scenes/1/motion","unmapped:/scenes/1/material","unmapped:/scenes/1/affect","unmapped:/scenes/1/place"],"schema_version":"0.4.0","_extraction":{"job":"batch-f36dc0501b5840b4b81f57bc99caa6dd","phase":"pilot20","attempt":12}}
