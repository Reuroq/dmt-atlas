{"report_id":"28473g","is_trip_report":true,"reason":"Writer recounts a just-completed personal ceremony with perceived entities.","scenes":[{"place":"","order":1,"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"beings":[{"form":["entities","all feminine presence"],"count_text":"these entities","behaviour":["acknowledged my presence"],"communication":["acknowledgement of presence"],"affect":[],"normalised":{"form":["other:entities","other:all feminine presence"],"behaviour":["other:acknowledged my presence"],"communication":["other:acknowledgement of presence"],"affect":[]}}],"transition_trigger":[],"affect":["awe","amusement","prior anxiety"],"quotes":[{"text":"It's like I was observer to an intergalatic circus","start":0,"end":50,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"I saw things that were truly out of this world.","start":174,"end":221,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"And I swear to god it's like these entities acknowledged my presence.","start":224,"end":293,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"Also, I detected all feminine presence. I didn't feel like there was any male presence at all.","start":296,"end":390,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false},{"text":"It's such a laugh when I come out of it because I think about how anxious I was prior to it starting.","start":1289,"end":1390,"anchor_score":1.0,"weak_anchor":false,"redacted":false,"ambiguous_anchor":false}],"normalised":{"light":[],"colour":[],"motion":[],"geometry":[],"material":[],"density":[],"scale":[],"affect":["awe","amusement","other:prior anxiety"],"transition_trigger":[],"place":"other:"}}],"flags":["unmapped:/scenes/0/affect","empty_descriptor:/scenes/0/place","unmapped:/scenes/0/place","unmapped:/scenes/0/beings/0/form","unmapped:/scenes/0/beings/0/beha